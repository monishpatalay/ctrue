{
  "name": "ctrue",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:demo": "node scripts/dev.mjs --demo",
    "dev:web": "npm run dev -w @ctrue/web",
    "dev:api": "npm run dev -w @ctrue/api",
    "dev:desktop": "npm run dev -w @ctrue/desktop",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && node --test scripts/dev.test.mjs",
    "test:database": "node scripts/test-database.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "package:mac": "npm run package:mac -w @ctrue/desktop",
    "package:win": "npm run package:win -w @ctrue/desktop",
    "test:e2e": "playwright test -c e2e",
    "test:coverage": "c8 --reporter=text-summary --reporter=text --include=apps/api/src/core.ts --include=apps/desktop/src/api.ts --include=apps/desktop/src/steps.ts --include=apps/desktop/electron/security.ts --include=apps/web/lib/events.mjs --include=apps/web/components/markdown.tsx npm test",
    "verify:release": "node scripts/verify-release.mjs",
    "test:load": "node scripts/test-database.mjs --load",
    "probe:production": "node scripts/probe-production.mjs",
    "test:ai": "node scripts/test-database.mjs --ai",
    "test:hearing": "node scripts/test-database.mjs --hearing"
  },
  "engines": {
    "node": ">=22.19"
  },
  "dependencies": {
    "@neon/config": "^1.9.1",
    "@neon/env": "^1.6.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "c8": "^12.0.0"
  }
}
