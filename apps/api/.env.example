HOST=127.0.0.1
PORT=4318
DEMO_MODE=false
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
WEB_URL=http://localhost:3000
# Neon: pooled PostgreSQL TLS URL, and the branch Auth URL (same value as the website's).
DATABASE_URL=
NEON_AUTH_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-live-transcribe
# PCM energy VAD: calibrate for microphone/system audio noise.
AUDIO_VAD_THRESHOLD=0.01
AUDIO_SILENCE_MS=600
TRIAL_SECONDS=600
# Number of proxies in front of the API: 0 locally, usually 1 on a hosting platform. Needed for per-address rate limits.
TRUST_PROXY=0
# false = free app: sessions are not charged and each user (except the owner) brings their own OpenAI key.
METERING=true
